                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Latest Exchange Rates (pass-through)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/exchange-rates?base=MYR&symbols=USD,SGD,EUR,GBP",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "exchange-rates"
              ],
              "query": [
                {
                  "key": "base",
                  "value": "MYR"
                },
                {
                  "key": "symbols",
                  "value": "USD,SGD,EUR,GBP"
                }
              ]
            },
            "description": "Postman -> /api/v1/exchange-rates -> https://open.er-api.com/v6/latest/{base}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "pm.test(\"Contains USD rate\", () => pm.expect(pm.response.json().data).to.have.property(\"USD\"));"
                ]
              }
            }
          ]
        }
      ]
