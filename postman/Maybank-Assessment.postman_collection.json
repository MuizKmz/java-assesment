        {
          "name": "Get Customer by ID (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Read-only @Transactional(readOnly = true) lookup."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "pm.test(\"Returns the created customer\", () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get(\"customerId\"))));"
                ]
              }
            }
          ]
        },
