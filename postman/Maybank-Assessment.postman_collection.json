        {
          "name": "Update Customer (UPDATE)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Updates mutable fields inside a @Transactional service method. Optimistic locking via @Version.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Muhammad Ali bin Abu (Updated)\",\n  \"email\": \"{{customerEmail}}\",\n  \"phoneNo\": \"+60198887777\",\n  \"status\": \"INACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "pm.test(\"Status updated\", () => pm.expect(pm.response.json().data.status).to.eql(\"INACTIVE\"));"
                ]
              }
            }
          ]
        }
      ]
