{
  "info": {
    "_postman_id": "9615aa94-e584-4428-9e01-919bf870695d",
    "name": "Maybank Java Backend Assessment",
    "description": "Customer account APIs (Spring Boot + MSSQL TESTDB).\n\nRun the whole collection with the Collection Runner: it creates a customer, reads, updates, paginates, calls the 3rd-party exchange rate API, then deletes the customer.\n\nEvery request/response is logged to logs/api-request-response.log with an X-Correlation-Id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Customers (INSERT / UPDATE / GET)",
      "item": [
        {
          "name": "Create Customer (INSERT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": "Creates a customer inside a @Transactional service method. Saves the new id to {{customerId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Muhammad Ali bin Abu\",\n  \"email\": \"ali.{{$timestamp}}@example.com\",\n  \"phoneNo\": \"+60123456789\",\n  \"initialDeposit\": 2500.75,\n  \"currency\": \"MYR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "const json = pm.response.json();",
                  "pm.test(\"Customer is ACTIVE with account number\", () => {",
                  "    pm.expect(json.data.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(json.data.accountNo).to.have.lengthOf(12);",
                  "});",
                  "pm.collectionVariables.set(\"customerId\", json.data.id);",
                  "pm.collectionVariables.set(\"customerEmail\", json.data.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Customer - Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "description": "Bean Validation failure returns 400 with per-field messages.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"phoneNo\": \"abc\",\n  \"initialDeposit\": -10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "pm.test(\"Returns field errors\", () => pm.expect(pm.response.json().fieldErrors).to.have.property(\"email\"));"
                ]
              }
            }
          ]
        },
