    {
      "name": "3. Nested 3rd-party API",
      "item": [
        {
          "name": "Convert Customer Balance to USD (nested 3rd-party call)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/1/balance/convert?to=USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "1",
                "balance",
                "convert"
              ],
              "query": [
                {
                  "key": "to",
                  "value": "USD"
                }
              ]
            },
            "description": "Postman -> /api/v1/customers/{id}/balance/convert -> reads customer from MSSQL -> calls https://open.er-api.com/v6/latest/{currency} -> returns converted balance."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Has exchange rate and converted balance\", () => { pm.expect(d.exchangeRate).to.be.above(0); pm.expect(d.convertedBalance).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Convert Created Customer Balance to SGD",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}/balance/convert?to=SGD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "{{customerId}}",
                "balance",
                "convert"
              ],
              "query": [
                {
                  "key": "to",
                  "value": "SGD"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has X-Correlation-Id header\", () => pm.response.to.have.header(\"X-Correlation-Id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Convert - Unsupported Currency (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
